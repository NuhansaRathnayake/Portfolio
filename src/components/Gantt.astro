---
// A 20-week rollout schedule with governance checkpoints.
// Phases and checkpoints are a real sequence, so numbering the checkpoints is meaningful.
const WEEKS = 20;
const phases = [
  { name: 'Initiate', start: 1, end: 2, tone: 'ink' },
  { name: 'Plan', start: 2, end: 6, tone: 'ink' },
  { name: 'Execute', start: 6, end: 16, tone: 'accent' },
  { name: 'Monitor and control', start: 3, end: 19, tone: 'line' },
  { name: 'Close', start: 17, end: 20, tone: 'ink' },
];
const checkpoints = [
  { week: 2, label: 'Risk register baselined and charter approved' },
  { week: 6, label: 'Access roles and policy review passed' },
  { week: 12, label: 'Security testing signed off' },
  { week: 16, label: 'Go-live compliance check' },
  { week: 20, label: 'Lessons-learned review published' },
];
const ticks = [1, 5, 9, 13, 17, 20];
const rows = phases.length + 2; // axis + phases + checkpoints
---

<figure class="m-0">
  <p class="muted mb-2 text-sm lg:hidden">Scroll sideways to see all 20 weeks.</p>
  <div class="overflow-x-auto rounded-xl border border-line bg-surface" tabindex="0" role="region" aria-label="Rollout schedule, scrollable">
    <div
      class="relative grid min-w-[44rem] items-center gap-y-2 p-5 sm:p-6"
      style={`grid-template-columns: 9.5rem repeat(${WEEKS}, minmax(0, 1fr)); grid-template-rows: repeat(${rows}, 2.25rem);`}
      role="img"
      aria-label="Schedule of a 20-week system rollout with five phases and five governance checkpoints. Full description follows."
    >
      <!-- column gridlines -->
      <div
        aria-hidden="true"
        class="pointer-events-none"
        style={`grid-column: 2 / -1; grid-row: 1 / -1; background-image: repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px calc(100% / ${WEEKS}));`}
      >
      </div>

      <!-- axis -->
      <div class="muted text-xs" style="grid-column: 1; grid-row: 1;">Week</div>
      {ticks.map((w) => (
        <div class="muted mono pl-1 text-xs" style={`grid-column: ${w + 1} / span ${w === WEEKS ? 1 : 2}; grid-row: 1;`}>{w}</div>
      ))}

      <!-- phases -->
      {phases.map((p, i) => (
        <>
          <div class="pr-3 text-[0.9375rem] font-medium" style={`grid-column: 1; grid-row: ${i + 2};`}>{p.name}</div>
          <div
            class:list={['gantt-bar rounded-md', p.tone === 'ink' && 'bg-ink', p.tone === 'accent' && 'bg-accent', p.tone === 'line' && 'border-2 border-accent bg-accent-soft']}
            style={`grid-column: ${p.start + 1} / ${p.end + 2}; grid-row: ${i + 2}; height: ${p.tone === 'line' ? '1rem' : '1.5rem'}; --i: ${i};`}
          >
            <span class="sr-only">Weeks {p.start} to {p.end}</span>
          </div>
        </>
      ))}

      <!-- checkpoints -->
      <div class="pr-3 text-[0.9375rem] font-medium" style={`grid-column: 1; grid-row: ${rows};`}>Governance checkpoints</div>
      {checkpoints.map((c, i) => (
        <div class="grid place-items-center" style={`grid-column: ${c.week + 1} / span 1; grid-row: ${rows};`}>
          <span class="gantt-mark grid h-6 w-6 place-items-center rounded-[5px] bg-accent-soft ring-2 ring-accent" style={`--i: ${i + 5};`}>
            <span class="-rotate-45 text-[0.6875rem] font-bold text-accent">{i + 1}</span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <figcaption class="mt-5">
    <p class="muted text-sm">Illustrative plan from Case study 1: a fictional student-records system rollout.</p>
    <ol class="mt-3 grid gap-x-8 gap-y-1.5 text-[0.9375rem] sm:grid-cols-2">
      {checkpoints.map((c, i) => (
        <li class="flex gap-3"><span class="mono w-4 shrink-0 font-semibold text-accent">{i + 1}</span><span>{c.label} <span class="muted">(week {c.week})</span></span></li>
      ))}
    </ol>
  </figcaption>
</figure>
