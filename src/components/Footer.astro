---
import { nav, site } from '../config/site';
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---

<footer class="mt-8 border-t border-line">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_auto]">
    <div>
      <p class="h3"><span class="text-accent">/</span> {site.name}</p>
      <p class="muted mt-2 max-w-sm text-[0.95rem]">
        All sample artifacts use fictional organisations. No real company data, credentials or private documents are published here.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-[0.95rem]">
        {nav.map((item) => (
          <li><a href={item.href} class="muted hover:text-accent">{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <SocialLinks />
  </div>
  <div class="border-t border-line">
    <p class="wrap muted py-4 text-sm">© {year} {site.name}. Built with Astro and Tailwind CSS.</p>
  </div>
</footer>
