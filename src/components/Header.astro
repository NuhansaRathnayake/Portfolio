---
import { Menu, X } from '@lucide/astro';
import { site, nav } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && href !== '/' && path.startsWith(href);
---

<header class="sticky top-3 z-50 px-3 sm:px-4">
  <div class="glass mx-auto flex h-14 max-w-[76rem] items-center justify-between gap-4 rounded-2xl pl-3 pr-2 sm:pl-4">
    <a href="/" class="flex items-center gap-3 font-semibold tracking-tight" aria-label={`${site.name}, home`}>
      <img src="/logo.png" alt="" width="459" height="330" class="h-9 w-auto" aria-hidden="true" />
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <nav aria-label="Main" data-nav class="hidden items-center gap-0.5 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class="rounded-lg px-3 py-2 text-[0.92rem] text-muted transition-colors hover:bg-white/5 hover:text-ink aria-[current]:bg-accent-soft aria-[current]:text-accent"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#contact" class="btn btn-primary hidden !px-4 !py-2 text-sm sm:inline-flex">Hire me</a>
      <button id="menu-toggle" type="button" class="icon-btn !h-10 !w-10 lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <Menu class="h-5 w-5" id="icon-open" aria-hidden="true" />
        <X class="hidden h-5 w-5" id="icon-close" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" data-nav class="glass mx-auto mt-2 hidden max-w-[76rem] rounded-2xl lg:hidden">
    <ul class="flex flex-col p-2">
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="block rounded-lg px-3 py-3 text-lg hover:bg-white/5 aria-[current]:text-accent">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const open = document.getElementById('icon-open');
  const close = document.getElementById('icon-close');
  const setMenu = (isOpen: boolean) => {
    menu?.classList.toggle('hidden', !isOpen);
    open?.classList.toggle('hidden', isOpen);
    close?.classList.toggle('hidden', !isOpen);
    menuBtn?.setAttribute('aria-expanded', String(isOpen));
    menuBtn?.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  };
  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
</script>
