---
import { getCollection, render } from 'astro:content';
import { ChevronDown } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import RiskRegister from '../../components/RiskRegister.astro';
import FrameworkMap from '../../components/FrameworkMap.astro';
import { studioRisks } from '../../data/artifacts';

const entries = (await getCollection('grc')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content })));

const groups = [
  { id: 'policies', title: 'Policy writing samples', type: 'Policy', intro: 'Short policies written for a fictional 12-person studio, in plain language that staff will actually read.' },
  { id: 'compliance', title: 'Compliance summaries', type: 'Compliance summary', intro: 'The regulations and standards most relevant to IT projects in Sri Lanka and for international clients.' },
  { id: 'awareness', title: 'Security awareness material', type: 'Awareness', intro: 'Training built around what people should do, not what they should fear.' },
  { id: 'articles', title: 'Articles', type: 'Article', intro: 'Short explainers on where project management and GRC meet.' },
] as const;

const jump = [
  { id: 'risk', label: 'Risk assessment' },
  { id: 'mapping', label: 'Framework mapping' },
  ...groups.map((g) => ({ id: g.id, label: g.title })),
];
---

<Base title="GRC" description="Governance, risk and compliance samples: risk register, ISO 27001 and NIST CSF mapping, policies, compliance summaries and awareness material.">
  <PageHeader
    title="Governance, risk and compliance"
    lede="Samples that show how I assess risk, map controls to frameworks and write policies. Everything uses fictional organisations."
  >
    <nav aria-label="On this page" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {jump.map((j) => (
          <li><a href={`#${j.id}`} class="inline-block rounded-full border border-line px-4 py-1.5 text-[0.9375rem] hover:border-ink hover:bg-surface">{j.label}</a></li>
        ))}
      </ul>
    </nav>
  </PageHeader>

  <section id="risk" class="section" aria-labelledby="risk-h">
    <div class="wrap">
      <h2 id="risk-h" class="h2">Risk assessment</h2>
      <p class="lede mb-8 mt-3">Likelihood, impact and treatment for a small organisation with no security team.</p>
      <RiskRegister risks={studioRisks} caption="Risk register: Northlight Studio, a fictional 12-person design studio" />
      <p class="mt-6"><a href="/projects/studio-security-gap-analysis/" class="link font-medium">Read the full case study</a></p>
    </div>
  </section>

  <section id="mapping" class="section" aria-labelledby="mapping-h">
    <div class="wrap">
      <h2 id="mapping-h" class="h2">Framework mapping</h2>
      <p class="lede mb-8 mt-3">ISO/IEC 27001:2022 controls matched to NIST CSF 2.0 outcomes, with the status and next action for each.</p>
      <FrameworkMap />
    </div>
  </section>

  {groups.map((g) => (
    <section id={g.id} class="section" aria-labelledby={`${g.id}-h`}>
      <div class="wrap">
        <h2 id={`${g.id}-h`} class="h2">{g.title}</h2>
        <p class="lede mb-8 mt-3">{g.intro}</p>
        <div class="divide-y divide-line rounded-xl border border-line bg-surface">
          {rendered.filter((r) => r.entry.data.type === g.type).map(({ entry, Content }) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 p-5 sm:p-6 [&::-webkit-details-marker]:hidden">
                <span>
                  <span class="h3 block">{entry.data.title}</span>
                  <span class="muted mt-1 block text-[0.9375rem]">{entry.data.summary}</span>
                </span>
                <ChevronDown class="mt-1 h-5 w-5 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
              </summary>
              <div class="md border-t border-line px-5 pb-8 pt-6 sm:px-6">
                <Content />
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>
