---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Project case studies with the documents behind them: charter, WBS, schedule, RACI and risk register.">
  <PageHeader title="Projects" lede="Case studies written the way a project is run: context, role, objectives, approach, deliverables, challenges and lessons." />
  <section class="wrap pb-20">
    {projects.map((p) => <ProjectRow project={p} />)}
  </section>
</Base>
