---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../config/site';
---

<Base title="Contact" description={`Contact ${site.name} about internships and graduate roles in IT project coordination, PMO and risk and compliance.`}>
  <PageHeader title="Contact" lede="Tell me about the role or the team. I reply within two working days." />
  <section class="wrap pb-20">
    <ContactSection />
  </section>
</Base>
