---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap py-24">
    <h1 class="h1">That page does not exist</h1>
    <p class="lede mt-5">The link may be out of date. Start from the home page or go straight to the projects.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="btn btn-primary">Go home</a>
      <a href="/projects/" class="btn btn-ghost">See projects</a>
    </div>
  </section>
</Base>
