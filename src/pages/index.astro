---
import { getCollection } from 'astro:content';
import { Download, ArrowRight, ArrowDown, GraduationCap, MapPin, Calendar, Users, ShieldCheck, ArrowUpRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SkillCarousel from '../components/SkillCarousel.astro';
import CertCarousel from '../components/CertCarousel.astro';
import EventCarousel from '../components/EventCarousel.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { technicalSkills, nonTechnicalSkills } from '../data/skills';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../config/site';
import { skillGroups, softSkills, approach, education, coursework, certifications, leadership, events } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const grcCount = (await getCollection('grc')).length;
const [first, ...rest] = site.name.split(' ');
const last = rest.join(' ');
---

<Base>
  <!-- ============ LANDING ============ -->
  <section id="top" class="landing" aria-label="Introduction">
    <span class="hero-word" aria-hidden="true">{first}</span>

    <div class="landing-main">
      <div class="wrap grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="eyebrow" data-reveal>Hello, I’m</p>

          <h1 class="hero-title mt-6" aria-label={site.name}>
            <span class="name-line name-first" aria-hidden="true">{[...first].map((ch, i) => <span class="char" style={`--i:${i}`}>{ch}</span>)}</span>
            <span class="name-line name-last" aria-hidden="true">{[...last].map((ch, i) => <span class="char" style={`--i:${i};--base:350ms`}>{ch}</span>)}</span>
          </h1>

          <p class="mt-6 text-[clamp(1.2rem,1rem+1vw,1.7rem)] font-medium" data-reveal style="--d:700ms">
            <span class="mono text-accent">&gt;</span>
            <span id="typed" data-roles={JSON.stringify(site.roles)}>{site.roles[0]}</span><span class="caret" aria-hidden="true"></span>
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--d:850ms">
            {site.cvUrl ? (
              <a href={site.cvUrl} class="btn btn-primary" download><Download class="h-4 w-4" aria-hidden="true" />Download CV</a>
            ) : (
              <span class="btn btn-primary" role="link" aria-disabled="true" title="Add Nuhansa-Rathnayake-CV.pdf to the public folder"><Download class="h-4 w-4" aria-hidden="true" />Download CV</span>
            )}
            <a href="/#projects" class="btn btn-ghost">View projects<ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
          </div>

          <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3" data-reveal style="--d:980ms"><span class="follow-label">Follow me on</span><SocialLinks large /></div>


        </div>

        <div class="relative mx-auto w-full max-w-[min(24rem,78vw)]" id="hero-art" data-reveal="scale" style="--d:300ms">

          <span class="hero-tags" aria-hidden="true"><span>Project Management</span><span>GRC</span></span>
          <span class="photo-glow" aria-hidden="true"></span>
          <div class="photo-simple">
            <div class="photo-card">
              {site.photo ? (
                <img src={site.photo} alt={`Portrait of ${site.name}`} width="640" height="800" fetchpriority="high" />
              ) : (
                <span class="monogram shimmer" aria-hidden="true">{site.initials}</span>
              )}
            </div>
          </div>



        </div>
      </div>
    </div>

    <div class="wrap"><div class="hero-meta">
      <div><span>Based in</span><strong>Sri Lanka</strong></div>
      <a href="/#about" class="scroll-fab" aria-label="Scroll down to About me"><ArrowDown aria-hidden="true" /></a>
      <div><span>Studying</span><strong>BSc. Information Technology</strong></div>
    </div></div>

  </section>

<SectionDivider n="01" label="About me" from="Home" />
  <!-- ============ ABOUT + SKILLS ============ -->
  <section id="about" class="section" aria-labelledby="about-h">
    <div class="wrap">

      <div class="about-grid">
        <div class="kboard" data-reveal="scale" aria-label={`Photo of ${site.name} pinned to a kanban board`}>
          <div class="kboard-bar" aria-hidden="true"><span></span><span></span><span></span><b>Portfolio board</b></div>
          <div class="kboard-cols">
            <div class="kcol kcol-side" aria-hidden="true">
              <p class="kcol-head">To do <em>2</em></p>
              <div class="kcard" style="--k:0"><span class="ktag">Risk</span>Risk register</div>
              <div class="kcard" style="--k:1"><span class="ktag">People</span>Stakeholder map</div>
            </div>
            <div class="kcol">
              <p class="kcol-head" aria-hidden="true">In progress <em>1</em></p>
              <figure class="pinned">
                <span class="clip" aria-hidden="true"><svg viewBox="0 0 30 84" fill="none"><defs><linearGradient id="clipg" x1="0" x2="1"><stop offset="0" stop-color="#8d9898"/><stop offset=".45" stop-color="#f2f5f5"/><stop offset="1" stop-color="#7c8888"/></linearGradient></defs><path d="M9 52V14a7 7 0 0 1 14 0v52a10 10 0 0 1-20 0V22" stroke="url(#clipg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <div class="pinned-card">
                  {site.photo ? (
                    <img src={site.photo} alt={`Portrait of ${site.name}`} width="640" height="800" loading="lazy" />
                  ) : (
                    <span class="monogram" aria-hidden="true">{site.initials}</span>
                  )}
                </div>
              </figure>
            </div>
            <div class="kcol kcol-side" aria-hidden="true">
              <p class="kcol-head">Done <em>2</em></p>
              <div class="kcard kcard-done" style="--k:2"><span class="ktag">Plan</span>Project plan</div>
              <div class="kcard kcard-done" style="--k:3"><span class="ktag">Agile</span>Sprint review</div>
            </div>
          </div>
        </div>

        <div data-reveal style="--d:150ms">
          <h2 id="about-h" class="h2 about-title">I like the part of IT that is about people, deadlines and decisions.</h2>
          <p class="about-text">I am a BSc in Information Technology undergraduate at Rajarata University of Sri Lanka, building a career in IT project management with a focus on Governance, Risk, and Compliance (GRC). I believe technology projects succeed when they are planned with clarity, governed with discipline, and protected by risk thinking from day one. I turn complex requirements into structured plans and clear accountability, using Agile and Waterfall where each fits best, with risk and compliance built into delivery from the start.</p>
        </div>
      </div>

      <div class="divider divider-lg mt-20" data-reveal><span>Technical skills</span></div>
      <div class="mt-8" data-reveal><SkillCarousel skills={technicalSkills} label="technical skills" /></div>

      <div class="divider divider-lg mt-16" data-reveal><span>Non-technical skills</span></div>
      <div class="mt-8" data-reveal><SkillCarousel skills={nonTechnicalSkills} label="non-technical skills" reverse /></div>

    </div>
  </section>

<SectionDivider n="02" label="Education" from="About me" />
  <!-- ============ EDUCATION + CERTIFICATIONS ============ -->
  <section id="education" class="section" aria-labelledby="edu-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="edu-h" class="h2">My Learning Journey</h2>
      </div>

      <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-24">
        <div>
          <h3 class="h3" data-reveal>Education</h3>
          <ol class="etl mt-8" data-draw>
            {education.map((e, i) => (
              <li class="etl-item" data-reveal style={`--d:${i * 120}ms`}>
                <span class="etl-node" aria-hidden="true"></span>
                <div class="etl-tags">
                  <span class="etl-year">{e.period}</span>
                  <span class="etl-tag">{e.tag}</span>
                </div>
                <div class="card spot etl-card">
                  <p class="h3">{e.degree}</p>
                  <p class="mt-1 text-accent">{e.school}</p>
                  {e.note && <p class="muted mt-3 text-[0.975rem]">{e.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="w-full max-w-[22rem] lg:justify-self-end">
          <h3 class="h3" data-reveal>Certifications</h3>
          <div class="mt-8" data-reveal><CertCarousel certs={certifications} /></div>
        </div>
      </div>
    </div>
  </section>

<SectionDivider n="03" label="Projects" from="Education" />
  <!-- ============ PROJECTS ============ -->
  <section id="projects" class="section" aria-labelledby="proj-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="proj-h" class="h2">Case studies with the documents behind them.</h2>
        <p class="lede mt-4">Each one covers the context, my role, the approach, the artifacts I produced and what I would change.</p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>

      <a href="/grc/" class="card spot group mt-6 grid gap-4 p-7 sm:grid-cols-[1fr_auto] sm:items-center" data-reveal>
        <div>
          <p class="h3 mt-3 text-[1.35rem]">Risk registers, control mapping, policies and compliance summaries</p>
          <p class="muted mt-2 max-w-2xl text-[0.975rem]">A full GRC section with a scored risk register, an ISO 27001 to NIST CSF gap analysis, policy samples and short summaries of GDPR, PCI DSS and Sri Lanka's PDPA.</p>
        </div>
        <span class="btn btn-ghost group-hover:border-accent group-hover:text-accent">Explore GRC<ArrowUpRight class="h-4 w-4" aria-hidden="true" /></span>
      </a>
    </div>
  </section>

<SectionDivider n="04" label="Leadership" from="Projects" />
  <!-- ============ LEADERSHIP ============ -->
  {leadership.length > 0 && (
    <section id="leadership" class="section" aria-labelledby="lead-h">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2 id="lead-h" class="h2">Roles where I was responsible for a team and a result.</h2>
        </div>
        <ol class="timeline mt-12 max-w-3xl space-y-8" data-draw>
          {leadership.map((l, i) => (
            <li class="timeline-item card spot p-6" data-reveal style={`--d:${i * 140}ms`}>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="h3">{l.role}</h3>
                <span class="mono muted text-xs">{l.period}</span>
              </div>
              <p class="mt-1 flex flex-wrap items-center gap-2 text-accent">{l.org}{l.sample && <span class="chip chip-med">Sample</span>}</p>
              <ul class="muted mt-4 list-disc space-y-1.5 pl-5 marker:text-accent">
                {l.points.map((p) => <li>{p}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

<SectionDivider n="05" label="Events" from="Leadership" />
  <!-- ============ EVENTS ============ -->
  {events.length > 0 && (
    <section id="events" class="section" aria-labelledby="events-h">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2 id="events-h" class="h2">Hackathons, workshops and events I've been part of.</h2>
        </div>
        <div class="mt-12"><EventCarousel events={events} /></div>
        <dialog id="lightbox" class="lightbox" aria-label="Event photo">
          <form method="dialog"><button class="lightbox-close" aria-label="Close photo">&times;</button></form>
          <img id="lightbox-img" alt="" />
        </dialog>
      </div>
    </section>
  )}

<SectionDivider n="06" label="Contact" from="Events" />
  <!-- ============ CONTACT ============ -->
  <section id="contact" class="section" aria-labelledby="contact-h">
    <div class="wrap">
      <div class="section-head mb-12" data-reveal>
        <h2 id="contact-h" class="h2">Hiring for a project coordination or risk role? Let's talk.</h2>
        <p class="lede mt-4">Tell me about the role or the team. I reply within two working days.</p>
      </div>
      <ContactSection />
    </div>
  </section>
</Base>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement | null;
  const big = document.getElementById('lightbox-img') as HTMLImageElement | null;
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((b) => b.addEventListener('click', () => {
    if (!box || !big) return;
    big.src = b.dataset.lightbox ?? '';
    big.alt = b.dataset.alt ?? '';
    box.showModal();
  }));
  box?.addEventListener('click', (e) => { if (e.target === box) box.close(); });
</script>

